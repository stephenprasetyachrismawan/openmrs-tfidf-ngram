<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC "-//OpenMRS//DTD OpenMRS Config 1.0//EN"
	"https://resources.openmrs.org/doctype/config-1.6.dtd">
<module configVersion="1.6">

	<id>${openmrsModuleId}</id>
	<name>${project.parent.name}</name>
	<version>${project.parent.version}</version>
	<package>org.openmrs.module.unifiedsearch</package>
	<author>Stephen Prasetya Chrismawan</author>
	<description>${project.parent.description}</description>
	<activator>org.openmrs.module.unifiedsearch.UnifiedSearchActivator</activator>

	<require_version>${openmrsPlatformVersion}</require_version>

	<!-- The admin-list entry point and the placeholder JSP are rendered by the legacy UI. -->
	<require_modules>
		<require_module version="${legacyuiVersion}">org.openmrs.module.legacyui</require_module>
	</require_modules>

	<extension>
		<point>org.openmrs.admin.list</point>
		<class>org.openmrs.module.unifiedsearch.extension.html.AdminList</class>
	</extension>

	<messages>
		<lang>en</lang>
		<file>messages.properties</file>
	</messages>
	<messages>
		<lang>id</lang>
		<file>messages_id.properties</file>
	</messages>

	<globalProperty>
		<property>unifiedsearch.alpha</property>
		<defaultValue>0.20</defaultValue>
		<description>
			Bobot jalur kata pada fusi K5 (0-1); sisanya (1-nilai) dipakai jalur
			kepingan karakter. Ditetapkan 0,20 dari sapuan 100 query dev (tugas 06,
			lihat docs/keputusan.md dan riset/hasil2/sapuan_alpha_dev.json). Ubah
			nilai ini untuk menguji ALPHA lain tanpa membangun ulang modul.
		</description>
	</globalProperty>
</module>
