{
  "$schema": "https://json.openmrs.org/routes.schema.json",
  "backendDependencies": {
    "webservices.rest": ">=2.2.0"
  },
  "extensions": [
    {
      "name": "unified-search-nav-form",
      "component": "unifiedSearchNavForm",
      "slot": "top-nav-actions-slot",
      "online": true,
      "offline": true,
      "order": 20
    },
    {
      "name": "unified-search-app-menu-item",
      "component": "unifiedSearchMenuLink",
      "slot": "app-menu-slot",
      "online": true,
      "offline": true
    },
    {
      "name": "comparison-app-menu-item",
      "component": "comparisonMenuLink",
      "slot": "app-menu-slot",
      "online": true,
      "offline": true
    },
    {
      "name": "ablation-app-menu-item",
      "component": "ablationMenuLink",
      "slot": "app-menu-slot",
      "online": true,
      "offline": true
    }
  ],
  "pages": [
    {
      "component": "root",
      "route": "unified-search"
    },
    {
      "component": "comparison",
      "route": "perbandingan-pencarian"
    },
    {
      "component": "ablation",
      "route": "pengujian-ablasi"
    }
  ]
}
